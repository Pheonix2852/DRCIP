# Environment - API (required on Render and locally)
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated; add multiple keys for zero-downtime rotation
API_KEYS=your_secret_api_key_here

# Cloudflare Workers AI embeddings (required)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
CLOUDFLARE_EMBEDDING_TIMEOUT_SECONDS=30
CLOUDFLARE_EMBEDDING_BATCH_SIZE=16
CLOUDFLARE_EMBEDDING_POOLING=cls

# Optional - defaults shown
QDRANT_COLLECTION=disaster_docs
GROQ_MODEL=openai/gpt-oss-20b
TOP_K=5
SCORE_THRESHOLD=0.30
