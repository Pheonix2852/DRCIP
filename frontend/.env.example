# Backend API base URL. The dev default is /api, proxied to localhost:5000.
VITE_API_URL=/api

# WebSocket URL. The dev default is ws://localhost:5000/ws.
VITE_WS_URL=ws://localhost:5000/ws

# Public site origin used for robots.txt and sitemap.xml.
# Required for production builds and must not be localhost.
VITE_SITE_ORIGIN=https://drcip.example.org
