# DRCIP Backend Environment Configuration
# Node Environment
NODE_ENV=development
PORT=5000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drcip?schema=public
# Optional test database override used by Vitest.
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/drcip_test?schema=public

# Authentication & Security
JWT_SECRET=dev-jwt-secret-do-not-use-in-production-must-be-32-chars-long
CORS_ORIGIN=http://localhost:5173

# Administrator seed account (used by `npm run db:seed`)
ADMIN_EMAIL=admin@drcip.local
ADMIN_PASSWORD=change-me-before-seeding

# FastAPI Intelligence Service
INTELLIGENCE_SERVICE_URL=http://localhost:8000

# Hosted RAG provider
# RAG_PROVIDER=mock disables the hosted call for local development/tests.
# RAG_SERVICE_URL is the base origin only; the backend appends /query.
# Local default; use https://drcip-rag.onrender.com for the deployed service.
RAG_PROVIDER=hosted
RAG_SERVICE_URL=http://localhost:8001
# Must be one of the RAG service's API_KEYS; when empty every query is UNAVAILABLE.
RAG_API_KEY=
# Render free services can cold-start; keep this above the expected cold start.
RAG_TIMEOUT_MS=60000

# External Providers
EMAIL_PROVIDER=mock
# Base URL used to build the password-reset link inside reset emails
# (e.g. frontend origin). Local dev default is http://localhost:5173.
RESET_URL_BASE=http://localhost:5173
# SMS dispatch is disabled unless a provider is configured (e.g. SMS_PROVIDER=mock).
#SMS_PROVIDER=mock

# Incident media storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Application Limits
MAX_PHOTO_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=26214400
MAX_VIDEO_DURATION_SECONDS=30
MAX_ATTACHMENTS_PER_INCIDENT=5